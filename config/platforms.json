{
  "_meta": {
    "version": 1,
    "updatedAt": "2026-10-19T10:10:00+08:00",
    "note": "数据驱动的平台注册表。加平台 = 在这里加一个块，不用改代码。字段含义见 docs/AGENT-ARCHITECTURE.md §2。",
    "conventions": {
      "{cdp}": "占位符，运行时会替换成该平台的 cdp 端口",
      "_probeUnverified": "该字段未实测验证，注册表校验会警告但不报错",
      "host": "用于 byHost() 反查；不确定就填最稳定的主域"
    },
    "global": [
      {
        "name": "进度记录",
        "match": "progress-report\\.mjs",
        "args": ["scripts/progress-report.mjs", "--every=300"],
        "uniq": true,
        "out": "runs/progress-console.log",
        "err": "runs/progress.err.log"
      }
    ]
  },

  "ccjyxy": {
    "label": "长春教师培训",
    "host": "col.ccjyxy.cn",
    "cdp": 9228,
    "capabilities": ["video"],
    "driver": {
      "script": "cc-cycle.mjs",
      "args": ["--port", "{cdp}", "--tab", "0"],
      "singleton": true,
      "out": "runs/cc-cycle-console.log",
      "err": "runs/cc-cycle.err.log"
    },
    "watchers": [
      {
        "script": "cc-watch.mjs",
        "args": ["--port", "{cdp}", "--every=180"],
        "uniq": true,
        "readOnly": true,
        "out": "runs/cc-watch-console.log",
        "err": "runs/cc-watch.err.log"
      }
    ],
    "categories": [
      { "key": "小初高公需", "goal": 30 },
      { "key": "初中学段通识", "goal": 15 },
      { "key": "专业课-初中数学", "goal": 45 }
    ],
    "completion": {
      "kind": "pageText",
      "scope": "trainingPage",
      "pattern": "已修\\s*([\\d.]+)\\s*/\\s*达标\\s*(\\d+)\\s*学时",
      "perCategoryPattern": "已修\\s*([\\d.]+)\\s*/\\s*达标\\s*(\\d+)\\s*学时\\s*·\\s*完成\\s*(\\d+)\\s*门",
      "verified": "2026-10-19",
      "verifiedNote": "平台只在课程结束回培训页时刷新；分类明细需逐标签试读（见 cc-lib.readCcStats）"
    },
    "constraints": {
      "maxParallel": 1,
      "creditsPerHour": 2.1,
      "accountingMaxRate": 1.25,
      "hardConstraints": [
        "单会话硬保护：同账号第二个播放页 → 旧页「本播放页已停止」+ report 接口 423 Locked",
        "MUI/React 按钮不响应合成 click()，必须 CDP 真鼠标事件",
        "记账硬卡 1.25x，播 2x 会有缺口，靠重播补录",
        "服务端钳位 position_sec，改 currentTime 跳不过去",
        "MUI Accordion 手风琴：展开一个分类，另外两个从 DOM 消失 → 必须一个分类一个进程"
      ]
    },
    "auth": {
      "loginUrl": "https://col.ccjyxy.cn/",
      "probe": "location.href.indexOf('login')<0 && !/登录/.test(document.title)",
      "fields": null,
      "captcha": "none",
      "sessionModel": "persistentProfile",
      "_note": "靠浏览器持久 profile 的 cookie；profile 丢/换机器要人工登录一次"
    },
    "heal": {
      "resetOnStall": ["runs/cc-skip.json", "runs/cc-claim.json"],
      "restartDriverOnStall": true
    }
  },

